# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL / Supabase)
# For Supabase: Copy connection string from Supabase Project Settings -> Database -> URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT Configuration (For future Auth phase)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Stripe Configuration (Test Mode)
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx
STRIPE_MONTHLY_PRICE_ID=price_xxxxxx_monthly
STRIPE_YEARLY_PRICE_ID=price_xxxxxx_yearly
CLIENT_SUCCESS_URL=http://localhost:3000/subscription/success?session_id={CHECKOUT_SESSION_ID}
CLIENT_CANCEL_URL=http://localhost:3000/subscription/cancel
